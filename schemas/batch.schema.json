{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lsbjordao/go-iucn-eoo-aoo/schemas/batch.schema.json",
  "title": "go-iucn-eoo-aoo batch output schema v1",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["taxon"],
    "properties": {
      "taxon": {"type": "string", "minLength": 1},
      "result": {"$ref": "result.schema.json"},
      "error": {"type": "string", "minLength": 1}
    },
    "oneOf": [
      {"required": ["result"], "not": {"required": ["error"]}},
      {"required": ["error"], "not": {"required": ["result"]}}
    ],
    "additionalProperties": false
  }
}
