{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lsbjordao/go-iucn-eoo-aoo/schemas/curation-log.schema.json",
  "title": "go-iucn-eoo-aoo curation log v1",
  "type": "object",
  "required": [
    "schema_version",
    "software_version",
    "manifest_sha256",
    "input_sha256",
    "output_sha256",
    "input_records",
    "output_records",
    "excluded",
    "note"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "software_version": {
      "type": "string"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "output_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_records": {
      "type": "integer",
      "minimum": 1
    },
    "output_records": {
      "type": "integer",
      "minimum": 1
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "input_index",
          "lon",
          "lat",
          "justification",
          "record"
        ],
        "properties": {
          "input_index": {
            "type": "integer",
            "minimum": 0
          },
          "record_id": {
            "type": "string"
          },
          "lon": {
            "type": "number"
          },
          "lat": {
            "type": "number"
          },
          "justification": {
            "type": "string"
          },
          "record": {
            "$ref": "result.schema.json#/$defs/point"
          }
        },
        "additionalProperties": false
      }
    },
    "note": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
